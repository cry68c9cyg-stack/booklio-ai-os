{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booklio-ai-os-development",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {"crons": ["0 * * * *"]},
  "durable_objects": {"bindings": [
    {"name": "TENANTS", "class_name": "TenantObject"},
    {"name": "REGISTRY", "class_name": "Registry"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["TenantObject", "Registry"]}]
}
